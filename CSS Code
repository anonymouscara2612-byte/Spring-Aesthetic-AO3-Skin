.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 🦋 ";
  color: transparent !important;
  text-shadow: 0 0 0 #E6CCD3;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 80px;
  height: 91px;
  background-image: url("https://64.media.tumblr.com/3b872f3b1b0ad1d7e9b7786d485b707f/24ea05b275a8459c-a7/s640x960/35f9c41a4ec7d482c4c15a7c5f7040244f0e26ee.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "𝓦𝓱𝓮𝓻𝓮 𝓯𝓵𝓸𝔀𝓮𝓻𝓼 𝓫𝓵𝓸𝓸𝓶, 𝓼𝓸 𝓭𝓸𝓮𝓼 𝓱𝓸𝓹𝓮...";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(23, 25, 19, 0.7);
  text-align: center;
  font-size: 14px;
  color: #E0E8D3;
  opacity: 1;
  white-space: pre;
}

